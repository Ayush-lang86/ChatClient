  <property name="styleSheet">
   <string notr="true">/*==================================================
                ROYAL GOLD THEME
==================================================*/

QMainWindow{
    background-color:#1B1B1B;
}

QWidget{
    background-color:#1B1B1B;
    color:#F5F5F5;
    font-family:&quot;Segoe UI&quot;;
    font-size:10pt;
}


/*========================
        HEADER
========================*/

QLabel#header{
    font-size:24px;
    font-weight:bold;
    color:gold;
}

QLabel#label{
    color:gold;
    font-size:13px;
    font-weight:bold;
}


/*========================
      CHAT WINDOW
========================*/

QTextBrowser{

    background:#252525;

    color:white;

    border:2px solid gold;

    border-radius:15px;

    padding:10px;

}


/*========================
       USER LIST
========================*/

QListWidget{

    background:#252525;

    color:white;

    border:2px solid gold;

    border-radius:15px;

    padding:5px;

    outline:none;

}

QListWidget::item{

    padding:8px;

    border-radius:8px;

}

QListWidget::item:hover{

    background:#3A3A3A;

}

QListWidget::item:selected{

    background:gold;

    color:black;

}


/*========================
      MESSAGE BOX
========================*/

QLineEdit{

    background:#2D2D2D;

    color:white;

    border:2px solid gold;

    border-radius:18px;

    padding:8px;

}

QLineEdit:focus{

    border:2px solid #FFD700;

}


/*========================
      SEND BUTTON
========================*/

QPushButton#sendButton{

    background:qlineargradient(
        x1:0,y1:0,
        x2:0,y2:1,
        stop:0 #FFD700,
        stop:1 #D4AF37
    );

    color:black;

    border:2px solid #FFF4A3;

    border-radius:18px;

    padding:8px 18px;

    font-weight:bold;

}

QPushButton#sendButton:hover{

    background:#FFE95E;

}

QPushButton#sendButton:pressed{

    background:#C9A000;

}


/*========================
   SELECT USERS BUTTON
========================*/

QPushButton#pushButton{

    background:#333333;

    color:gold;

    border:2px solid gold;

    border-radius:15px;

    padding:8px;

    font-weight:bold;

}

QPushButton#pushButton:hover{

    background:#444444;

}

QPushButton#pushButton:pressed{

    background:#222222;

}


/*========================
      SCROLL BARS
========================*/

QScrollBar:vertical{

    background:#222;

    width:12px;

    border-radius:6px;

}

QScrollBar::handle:vertical{

    background:gold;

    border-radius:6px;

}

QScrollBar::handle:vertical:hover{

    background:#FFE95E;

}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical{

    height:0;

}

QScrollBar:horizontal{

    background:#222;

    height:12px;

}

QScrollBar::handle:horizontal{

    background:gold;

    border-radius:6px;

}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal{

    width:0;

}


/*========================
      STATUS BAR
========================*/

QStatusBar{

    background:#151515;

    color:gold;

}</string>
